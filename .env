##PORT SERVER
PORT=3000

##POSTGRESQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=banco_verde_iam
POSTGRES_USER=bv_user
POSTGRES_PASSWORD=bv_password

##JWT
JWT_SECRET=dev-access-secret-change-in-production
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

##LOCKOUT
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

##TOKEN BUILDER (deprecated - using own IAM)
#URL_TOKEN_BUILDER=

##ORACLE (deprecated - using PostgreSQL)
#ORACLE_HOST=
#ORACLE_PORT=
#ORACLE_DB_NAME=
#ORACLE_USER=
#ORACLE_PASSWORD=

##RATE-LIMITING
TIME=60
LIMITING=100

##CORS
CORS=http://localhost:3001,http://192.168.1.104

##AES_KEY (for token encryption - deprecated, using JWT only)
#AES_KEY=

##MFA Encryption
MFA_ENCRYPTION_KEY=banco-verde-mfa-encryption-key-2024-secure

##Firebase Cloud Messaging (Push Notifications)
# FIREBASE_SERVICE_ACCOUNT - JSON stringified service account from Firebase Console
# Example format:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

##Loki (Log Monitoring)
# Default: localhost:3100 (when using docker-compose)
# LOKI_HOST=localhost
# LOKI_PORT=3100
